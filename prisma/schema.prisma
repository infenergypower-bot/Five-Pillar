  productionBudget        Decimal                  @default(0) @db.Decimal(14, 2)
  releaseBudget           Decimal                  @default(0) @db.Decimal(14, 2)
  currency                String                   @default("USD")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects                Project[]
  rights                  RightsRecord[]
  financingSources        FinancingSource[]
  distributionAssumptions DistributionAssumption[]
  recoupmentTiers         RecoupmentTier[]
  projections             FinancialProjection[]

  @@unique([organizationId, workingTitle])
  @@index([organizationId, rightsStatus])
}

model RightsRecord {
  id               String        @id @default(cuid())
  originalTitleId  String
  rightType        String
  ownerName        String
  ownershipPercent Decimal?      @db.Decimal(7, 4)
  status           RightsStatus
  territories      String[]
  media            String[]
  exclusive        Boolean       @default(false)
  startsAt         DateTime?
  expiresAt        DateTime?
  terms            Json?
  originalTitle    OriginalTitle @relation(fields: [originalTitleId], references: [id], onDelete: Cascade)

  @@index([originalTitleId, status])
}

model FinancingSource {
  id              String                  @id @default(cuid())
  originalTitleId String
  name            String
  type            String
  status          FinancingStatus         @default(PROSPECTIVE)
  committedAmount Decimal                 @default(0) @db.Decimal(14, 2)
  receivedAmount  Decimal                 @default(0) @db.Decimal(14, 2)
  currency        String                  @default("USD")
  terms           Json?
  originalTitle   OriginalTitle           @relation(fields: [originalTitleId], references: [id], onDelete: Cascade)
  contributions   FinancingContribution[]

  @@index([originalTitleId, status])
}

model FinancingContribution {
  id                String          @id @default(cuid())
  financingSourceId String
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @default("USD")
  receivedAt        DateTime
  reference         String?
  financingSource   FinancingSource @relation(fields: [financingSourceId], references: [id], onDelete: Cascade)

  @@index([financingSourceId, receivedAt])
}

model DistributionAssumption {
  id                   String        @id @default(cuid())
  originalTitleId      String
  channel              String
  territory            String?
  grossReceipts        Decimal       @db.Decimal(14, 2)
  distributionFeeRate  Decimal       @default(0) @db.Decimal(7, 4)
  distributionExpenses Decimal       @default(0) @db.Decimal(14, 2)
  netReceipts          Decimal       @db.Decimal(14, 2)
  probability          Decimal?      @db.Decimal(5, 4)
  notes                String?
  originalTitle        OriginalTitle @relation(fields: [originalTitleId], references: [id], onDelete: Cascade)

  @@index([originalTitleId, channel])
}

model RecoupmentTier {
  id               String          @id @default(cuid())
  originalTitleId  String
  priority         Int
  participant      String
  basis            RecoupmentBasis
  recoupableAmount Decimal?        @db.Decimal(14, 2)
  shareRate        Decimal         @db.Decimal(7, 4)
  capAmount        Decimal?        @db.Decimal(14, 2)
  terms            Json?
  originalTitle    OriginalTitle   @relation(fields: [originalTitleId], references: [id], onDelete: Cascade)

  @@unique([originalTitleId, priority])
}

model FinancialProjection {
  id                     String        @id @default(cuid())
  originalTitleId        String
  scenario               String
  productionCost         Decimal       @db.Decimal(14, 2)
  releaseCost            Decimal       @db.Decimal(14, 2)
  grossReceipts          Decimal       @db.Decimal(14, 2)
  distributionDeductions Decimal       @db.Decimal(14, 2)
  netReceipts            Decimal       @db.Decimal(14, 2)
  recoupment             Decimal       @db.Decimal(14, 2)
  projectedProfit        Decimal       @db.Decimal(14, 2)
  breakEvenRevenue       Decimal       @db.Decimal(14, 2)
  revenueAt50Margin      Decimal       @db.Decimal(14, 2)
  revenueAt55Margin      Decimal       @db.Decimal(14, 2)
  revenueAt60Margin      Decimal       @db.Decimal(14, 2)
  speculative            Boolean       @default(true)
  createdAt              DateTime      @default(now())
  originalTitle          OriginalTitle @relation(fields: [originalTitleId], references: [id], onDelete: Cascade)

  @@unique([originalTitleId, scenario])
}

model AutomationRule {
  id                    String          @id @default(cuid())
  organizationId        String
  name                  String
  triggerType           String
  conditions            Json?
  actions               Json
  active                Boolean         @default(true)
  requiresHumanApproval Boolean         @default(false)
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs                  AutomationRun[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model AutomationRun {
  id             String         @id @default(cuid())
  ruleId         String
  triggerEventId String?
  status         JobStatus      @default(QUEUED)
  input          Json
  output         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ipAddress      String?
  correlationId  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([correlationId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  CREATIVE_DIRECTOR
  PRODUCER_EDITOR
  SALES_ACCOUNT
  FINANCE
  CLIENT
  EXTERNAL_COLLABORATOR
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ServicePath {
  VISUAL_PRODUCTION
  MANAGED_MARKETING
  COMBINED
  ORIGINAL_ENTERTAINMENT
  CUSTOM
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IntakeStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  COMPLETE
  ARCHIVED
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  FILE
  EMAIL
  PHONE
  URL
}

enum QuoteStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ProjectStatus {
  INTAKE
  AWAITING_ASSETS
  DISCOVERY_COMPLETE
  CONCEPT_DEVELOPMENT
  SCRIPT_DEVELOPMENT
  SCRIPT_REVIEW
  VISUAL_DEVELOPMENT
  STORYBOARDING
  PRODUCTION_READY
  GENERATION
  EDITING
  INTERNAL_REVIEW
  CLIENT_REVIEW
  REVISIONS
  FINAL_APPROVAL
  AWAITING_FINAL_PAYMENT
  DELIVERY
  COMPLETED
  ARCHIVED
  ON_HOLD
  CANCELLED
}

enum WorkStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

enum ApprovalType {
  CONCEPT
  SCRIPT
  CHARACTER
  PRODUCT_ACCURACY
  STORYBOARD
  ROUGH_CUT
  FINAL_CUT
  FINAL_DELIVERY
  MARGIN_EXCEPTION
  CONTRACT
  OTHER
}

enum RevisionCategory {
  INCLUDED_CORRECTION
  TECHNICAL_DEFECT
  CREATIVE_ADJUSTMENT
  CLIENT_CHANGE_OF_DIRECTION
  ADDITIONAL_DELIVERABLE
  OUT_OF_SCOPE_REQUEST
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
  ONE_TIME
  USAGE
}

enum AllocationMethod {
  ACTUAL_USAGE
  WEIGHTED
  FIXED_PERCENT
  FALLBACK
  NONE
}

enum LedgerEntryType {
  ALLOWANCE
  USAGE
  PURCHASE
  ADJUSTMENT
  EXPIRATION
}

enum GenerationStatus {
  PLANNED
  QUEUED
  RUNNING
  APPROVED
  REJECTED
  FAILED
  CANCELLED
}

enum AssetStatus {
  PENDING_SCAN
  AVAILABLE
  QUARANTINED
  REJECTED
  ARCHIVED
}

enum RightsStatus {
  UNKNOWN
  PENDING
  CLEARED
  RESTRICTED
  EXPIRED
}

enum DeliveryStatus {
  DRAFT
  READY
  BLOCKED
  DELIVERED
  ACCEPTED
  REVOKED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WEBHOOK
}

enum IPFormat {
  SHORT_FILM
  FEATURE_FILM
  SERIES
  MUSIC_VIDEO
  TRAILER
  PROOF_OF_CONCEPT
  OTHER
}

enum FinancingStatus {
  PROSPECTIVE
  COMMITTED
  RECEIVED
  REJECTED
  RETURNED
}

enum RecoupmentBasis {
  GROSS_RECEIPTS
  NET_RECEIPTS
  DISTRIBUTABLE_PROFIT
}

model Organization {
  id             String                    @id @default(cuid())
  name           String
  slug           String                    @unique
  currency       String                    @default("USD")
  timezone       String                    @default("America/Chicago")
  minimumMargin  Decimal                   @default(0.50) @db.Decimal(5, 4)
  targetMargin   Decimal                   @default(0.55) @db.Decimal(5, 4)
  premiumMargin  Decimal                   @default(0.60) @db.Decimal(5, 4)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  users          User[]
  roles          AccessRole[]
  clients        Client[]
  leads          Lead[]
  brands         Brand[]
  products       Product[]
  questionnaires QuestionnaireDefinition[]
  packages       ServicePackage[]
  catalogItems   CatalogItem[]
  priceBooks     PriceBook[]
  laborRoles     LaborRole[]
  marginSettings MarginSetting[]
  overheadRules  OverheadRule[]
  quotes         Quote[]
  proposals      Proposal[]
  contracts      Contract[]
  projects       Project[]
  invoices       Invoice[]
  payments       Payment[]
  subscriptions  Subscription[]
  modelRates     ModelRate[]
  expenses       Expense[]
  originalTitles OriginalTitle[]
  connections    IntegrationConnection[]
  automations    AutomationRule[]
  auditEvents    AuditEvent[]
}

model User {
  id                  String               @id @default(cuid())
  organizationId      String
  email               String
  name                String
  passwordHash        String?
  role                Role
  active              Boolean              @default(true)
  mfaRequired         Boolean              @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaEnrollment       MfaEnrollment?
  loginAttempts       LoginAttempt[]
  roles               UserRole[]
  ownedLeads          Lead[]               @relation("LeadOwner")
  teamMemberships     ProjectTeamMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  auditEvents         AuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, role, active])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MfaEnrollment {
  id                 String    @id @default(cuid())
  userId             String    @unique
  secretCiphertext   String?
  recoveryCodeHashes String[]
  verifiedAt         DateTime?
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id              String   @id @default(cuid())
  userId          String?
  organizationId  String?
  emailNormalized String
  ipAddress       String
  succeeded       Boolean
  failureReason   String?
  attemptedAt     DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailNormalized, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([userId, attemptedAt])
}

model RateLimitBucket {
  id            String    @id @default(cuid())
  keyHash       String
  action        String
  windowStart   DateTime
  windowSeconds Int
  count         Int       @default(0)
  blockedUntil  DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([keyHash, action, windowStart])
  @@index([action, blockedUntil])
}

model AccessRole {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  systemKey      Role?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Lead {
  id               String             @id @default(cuid())
  organizationId   String
  ownerId          String?
  businessName     String
  contactName      String
  email            String
  phone            String?
  source           String?
  stage            LeadStage          @default(NEW)
  serviceInterests ServicePath[]
  opportunityValue Decimal?           @db.Decimal(14, 2)
  currency         String             @default("USD")
  nextFollowUpAt   DateTime?
  lostReason       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageHistory     LeadStageHistory[]
  activities       CrmActivity[]

  @@index([organizationId, stage])
  @@index([ownerId, nextFollowUpAt])
}

model LeadStageHistory {
  id        String     @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  reason    String?
  changedAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt])
}

model CrmActivity {
  id           String    @id @default(cuid())
  leadId       String?
  clientId     String?
  type         String
  subject      String
  body         String?
  occurredAt   DateTime  @default(now())
  nextActionAt DateTime?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
  @@index([clientId, occurredAt])
}

model Client {
  id                   String                @id @default(cuid())
  organizationId       String
  legalName            String
  displayName          String
  website              String?
  industry             String?
  businessType         String?
  timezone             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts             Contact[]
  brands               Brand[]
  products             Product[]
  activities           CrmActivity[]
  intakes              Intake[]
  quotes               Quote[]
  proposals            Proposal[]
  contracts            Contract[]
  projects             Project[]
  invoices             Invoice[]
  serviceSubscriptions ServiceSubscription[]

  @@unique([organizationId, displayName])
  @@index([organizationId])
}

model Contact {
  id                     String  @id @default(cuid())
  clientId               String
  name                   String
  email                  String
  phone                  String?
  title                  String?
  isPrimary              Boolean @default(false)
  canApproveSpend        Boolean @default(false)
  canApproveCreative     Boolean @default(false)
  preferredCommunication String?
  client                 Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId, isPrimary])
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  profile        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, clientId, name])
  @@index([organizationId, clientId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  brandId        String?
  name           String
  description    String?
  sku            String?
  price          Decimal?     @db.Decimal(14, 2)
  currency       String       @default("USD")
  claims         Json?
  restrictions   Json?
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sku])
  @@index([clientId, brandId])
}

model QuestionnaireDefinition {
  id             String                 @id @default(cuid())
  organizationId String
  key            String
  name           String
  servicePath    ServicePath?
  status         RecordStatus           @default(DRAFT)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       QuestionnaireVersion[]

  @@unique([organizationId, key])
}

model QuestionnaireVersion {
  id           String                  @id @default(cuid())
  definitionId String
  version      Int
  title        String
  publishedAt  DateTime?
  retiredAt    DateTime?
  definition   QuestionnaireDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  sections     QuestionnaireSection[]
  intakes      Intake[]

  @@unique([definitionId, version])
}

model QuestionnaireSection {
  id          String               @id @default(cuid())
  versionId   String
  key         String
  title       String
  description String?
  sortOrder   Int
  version     QuestionnaireVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions   QuestionDefinition[]

  @@unique([versionId, key])
  @@index([versionId, sortOrder])
}

model QuestionDefinition {
  id               String               @id @default(cuid())
  sectionId        String
  key              String
  label            String
  description      String?
  helpText         String?
  type             QuestionType
  required         Boolean              @default(false)
  recommended      Boolean              @default(false)
  internalOnly     Boolean              @default(false)
  allowsFile       Boolean              @default(false)
  validation       Json?
  sortOrder        Int
  section          QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options          QuestionOption[]
  conditions       QuestionCondition[]  @relation("ConditionalQuestion")
  sourceConditions QuestionCondition[]  @relation("SourceQuestion")
  answers          IntakeAnswer[]

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
}

model QuestionOption {
  id         String             @id @default(cuid())
  questionId String
  value      String
  label      String
  sortOrder  Int
  question   QuestionDefinition @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
}

model QuestionCondition {
  id               String             @id @default(cuid())
  questionId       String
  sourceQuestionId String
  operator         String
  expectedValue    Json
  question         QuestionDefinition @relation("ConditionalQuestion", fields: [questionId], references: [id], onDelete: Cascade)
  sourceQuestion   QuestionDefinition @relation("SourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([sourceQuestionId])
}

model Intake {
  id                     String               @id @default(cuid())
  clientId               String?
  questionnaireVersionId String
  version                Int                  @default(1)
  servicePath            ServicePath
  status                 IntakeStatus         @default(DRAFT)
  completeness           Int                  @default(0)
  readiness              Json?
  submittedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  client                 Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  answers                IntakeAnswer[]
  serviceSelections      ServiceSelection[]
  briefs                 ProductionBrief[]

  @@unique([clientId, questionnaireVersionId, version])
  @@index([clientId, status])
}

model IntakeAnswer {
  id           String             @id @default(cuid())
  intakeId     String
  questionId   String
  value        Json
  isDraft      Boolean            @default(true)
  answeredById String?
  answeredAt   DateTime           @default(now())
  intake       Intake             @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  question     QuestionDefinition @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([intakeId, questionId])
}

model ServiceSelection {
  id            String      @id @default(cuid())
  intakeId      String
  servicePath   ServicePath
  configuration Json?
  intake        Intake      @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@unique([intakeId, servicePath])
}

model ProductionBrief {
  id                     String    @id @default(cuid())
  intakeId               String
  title                  String
  objectives             Json
  audience               Json?
  creativeDirection      Json?
  productionRequirements Json?
  sourceMaterials        Json?
  rightsRequirements     Json?
  approvedAt             DateTime?
  intake                 Intake    @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId])
}

model ServicePackage {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  servicePath         ServicePath
  startingPrice       Decimal      @db.Decimal(14, 2)
  currency            String       @default("USD")
  scope               Json
  limits              Json?
  estimatedHours      Decimal?     @db.Decimal(10, 2)
  internalCostCeiling Decimal?     @db.Decimal(14, 2)
  targetMargin        Decimal      @default(0.55) @db.Decimal(5, 4)
  exclusions          Json?
  contractTerms       Json?
  active              Boolean      @default(true)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotes              Quote[]

  @@unique([organizationId, name])
  @@index([organizationId, servicePath, active])
}

model CatalogItem {
  id             String          @id @default(cuid())
  organizationId String
  sku            String
  name           String
  category       String
  servicePath    ServicePath?
  unit           String
  baseCost       Decimal         @db.Decimal(14, 2)
  basePrice      Decimal?        @db.Decimal(14, 2)
  currency       String          @default("USD")
  configuration  Json?
  active         Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBookItems PriceBookItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, category, active])
}

model PriceBook {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  currency       String          @default("USD")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  active         Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PriceBookItem[]

  @@unique([organizationId, name])
}

model PriceBookItem {
  priceBookId     String
  catalogItemId   String
  unitPrice       Decimal     @db.Decimal(14, 2)
  minimumQuantity Decimal?    @db.Decimal(10, 2)
  configuration   Json?
  priceBook       PriceBook   @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@id([priceBookId, catalogItemId])
}

model LaborRole {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rates          LaborRate[]

  @@unique([organizationId, name])
}

model LaborRate {
  id               String    @id @default(cuid())
  laborRoleId      String
  hourlyCost       Decimal   @db.Decimal(10, 2)
  loadedHourlyCost Decimal?  @db.Decimal(10, 2)
  currency         String    @default("USD")
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  laborRole        LaborRole @relation(fields: [laborRoleId], references: [id], onDelete: Cascade)

  @@index([laborRoleId, effectiveFrom])
}

model MarginSetting {
  id             String       @id @default(cuid())
  organizationId String
  servicePath    ServicePath?
  minimumMargin  Decimal      @db.Decimal(5, 4)
  targetMargin   Decimal      @db.Decimal(5, 4)
  premiumMargin  Decimal      @db.Decimal(5, 4)
  effectiveFrom  DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, servicePath, effectiveFrom])
}

model OverheadRule {
  id                        String           @id @default(cuid())
  organizationId            String
  name                      String
  allocationMethod          AllocationMethod
  rate                      Decimal?         @db.Decimal(10, 4)
  fixedAmount               Decimal?         @db.Decimal(14, 2)
  currency                  String           @default("USD")
  servicePaths              ServicePath[]
  excludesStandaloneHosting Boolean          @default(true)
  configuration             Json?
  active                    Boolean          @default(true)
  organization              Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
}

model Quote {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String?
  packageId      String?
  projectTitle   String
  servicePath    ServicePath
  status         QuoteStatus     @default(DRAFT)
  currency       String          @default("USD")
  currentVersion Int             @default(1)
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  package        ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  versions       QuoteVersion[]
  proposals      Proposal[]
  project        Project?

  @@index([organizationId, status])
  @@index([clientId, createdAt])
}

model QuoteVersion {
  id               String           @id @default(cuid())
  quoteId          String
  version          Int
  status           QuoteStatus      @default(DRAFT)
  configuration    Json?
  laborSubtotal    Decimal          @default(0) @db.Decimal(14, 2)
  nonLaborSubtotal Decimal          @default(0) @db.Decimal(14, 2)
  overhead         Decimal          @default(0) @db.Decimal(14, 2)
  contingency      Decimal          @default(0) @db.Decimal(14, 2)
  allInCost        Decimal          @db.Decimal(14, 2)
  subtotal         Decimal          @db.Decimal(14, 2)
  discount         Decimal          @default(0) @db.Decimal(14, 2)
  finalPrice       Decimal          @db.Decimal(14, 2)
  targetMargin     Decimal          @db.Decimal(5, 4)
  operatingProfit  Decimal          @db.Decimal(14, 2)
  operatingMargin  Decimal          @db.Decimal(5, 4)
  minimumPrice     Decimal          @db.Decimal(14, 2)
  recommendedPrice Decimal          @db.Decimal(14, 2)
  premiumPrice     Decimal          @db.Decimal(14, 2)
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  quote            Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lines            QuoteLine[]
  estimates        CostEstimate[]
  marginOverrides  MarginOverride[]

  @@unique([quoteId, version])
  @@index([quoteId, status])
}

model QuoteLine {
  id              String       @id @default(cuid())
  quoteVersionId  String
  category        String
  description     String
  quantity        Decimal      @db.Decimal(10, 2)
  unitCost        Decimal      @db.Decimal(14, 2)
  clientUnitPrice Decimal?     @db.Decimal(14, 2)
  currency        String       @default("USD")
  internalOnly    Boolean      @default(true)
  servicePath     ServicePath?
  sortOrder       Int          @default(0)
  quoteVersion    QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

